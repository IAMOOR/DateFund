{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string", "description": "User's display name" },
        "email": { "type": "string", "description": "User's email" },
        "photoURL": { "type": "string", "description": "User's photo URL" },
        "relationshipStartDate": { "type": "string", "format": "date", "description": "Anniversary date" },
        "partnerUid": { "type": "string", "description": "Partner UID" },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "User access role" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account creation timestamp" }
      },
      "required": ["uid", "email"]
    },
    "BucketListItem": {
      "title": "BucketListItem",
      "description": "A wishlist item for future dates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "estimatedBudget": { "type": "number" },
        "notes": { "type": "string" },
        "season": { "type": "string" },
        "addedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "category", "createdAt"]
    },
    "Goal": {
      "title": "Goal",
      "description": "A saving goal for a couple",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerUid": { "type": "string", "description": "UID of the user who created the goal" },
        "collaborators": { "type": "array", "items": { "type": "string" }, "description": "List of UIDs who can access the goal" },
        "name": { "type": "string" },
        "targetAmount": { "type": "number" },
        "currentAmount": { "type": "number" },
        "deadline": { "type": "string", "format": "date" },
        "archived": { "type": "boolean" },
        "archivedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUid", "name", "targetAmount", "currentAmount", "deadline"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A deposit or withdrawal record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerUid": { "type": "string" },
        "goalId": { "type": "string" },
        "goalName": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date" },
        "contributor": { "type": "string", "enum": ["Me", "Them"] },
        "type": { "type": "string", "enum": ["deposit", "withdrawal"] },
        "notes": { "type": "string" },
        "collaborators": { "type": "array", "description": "List of UIDs who can access the transaction" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUid", "goalId", "amount", "date", "contributor", "type"]
    },
    "Event": {
      "title": "Event",
      "description": "A scheduled date or event",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerUid": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "time": { "type": "string" },
        "location": { "type": "string" },
        "goalId": { "type": "string" },
        "estimatedBudget": { "type": "number" },
        "dressCode": { "type": "string" },
        "checklist": { "type": "array" },
        "itinerary": { "type": "array" },
        "reminder": { "type": "boolean" },
        "reminderMinutes": { "type": "number" },
        "reminderSent": { "type": "boolean" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "mood": { "type": "string" },
        "isMystery": { "type": "boolean" },
        "mysteryRevealed": { "type": "boolean" },
        "mysteryClue": { "type": "string" },
        "collaborators": { "type": "array", "items": { "type": "string" } },
        "rsvps": { "type": "object" },
        "completed": { "type": "boolean" },
        "memory": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUid", "title", "date"]
    },
    "PartnerMessage": {
      "title": "PartnerMessage",
      "description": "A real-time chat message, love note, date invite, goal nudge, shared date spot, poll, or deposit celebration between partners",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderUid": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderPhoto": { "type": "string", "maxLength": 500 },
        "participants": { "type": "array", "description": "UIDs of the couple participating in the thread" },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "messageType": {
          "type": "string",
          "enum": ["text", "date_invite", "goal_nudge", "love_note", "spot_share", "date_poll", "deposit_celebration"]
        },
        "linkedGoalId": { "type": "string", "maxLength": 128 },
        "linkedGoalName": { "type": "string", "maxLength": 150 },
        "linkedEventId": { "type": "string", "maxLength": 128 },
        "linkedEventTitle": { "type": "string", "maxLength": 200 },
        "linkedSpot": { "type": "object" },
        "pollData": { "type": "object" },
        "pollVotes": { "type": "object" },
        "spotVotes": { "type": "object" },
        "rsvpStatus": { "type": "object" },
        "depositData": { "type": "object" },
        "replyTo": { "type": "object" },
        "isPinned": { "type": "boolean" },
        "reactions": { "type": "object" },
        "readBy": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "senderUid", "senderName", "participants", "text", "messageType", "createdAt"]
    },
    "TypingStatus": {
      "title": "TypingStatus",
      "description": "Real-time partner typing presence indicator",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "partnerUid": { "type": "string", "maxLength": 128 },
        "isTyping": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["uid", "userName", "partnerUid", "isTyping", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "Private user profiles"
    },
    "/users/{uid}/bucketList/{itemId}": {
      "schema": "BucketListItem",
      "description": "Private user wishlist and bucket list destinations"
    },
    "/goals/{goalId}": {
      "schema": "Goal",
      "description": "Saving goals with strict owner-collaborator separation"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Financial transactions verified against member goals"
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Scheduled events with owner-only access control changes"
    },
    "/messages/{messageId}": {
      "schema": "PartnerMessage",
      "description": "Partner chat messages scoped strictly to conversation participants"
    },
    "/typingStatus/{userId}": {
      "schema": "TypingStatus",
      "description": "Ephemeral real-time typing state readable only by the user and their linked partner"
    }
  }
}


